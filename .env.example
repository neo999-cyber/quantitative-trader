# Copy to .env (or export in your shell). Nothing here is required for the
# offline parts of the system (gauntlet, sizing, journal, backtests on CSVs).

# Anthropic API key - needed only for `centaur catalyst` (earnings-call synthesis).
ANTHROPIC_API_KEY=

# Unusual Whales API key - optional, used by `centaur flow --provider unusualwhales`.
UNUSUAL_WHALES_API_KEY=
UNUSUAL_WHALES_BASE_URL=https://api.unusualwhales.com

# Account settings (can also live in centaur.json - see README).
CENTAUR_EQUITY=10000
CENTAUR_RISK_PCT=0.01
