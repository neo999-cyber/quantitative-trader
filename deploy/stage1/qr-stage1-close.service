[Unit]
Description=qr: stage 1 — a session failed or ended not flat: reconcile, flatten, alert

[Service]
Type=oneshot
WorkingDirectory=/root/stage1
Environment=QR_ROOT=/root/stage1/lake
EnvironmentFile=-/root/stage1/env
ExecStart=/usr/bin/python3 scripts/study_stage1.py close --config study/stage1.live.json --i-have-the-owners-yes
ExecStartPost=/usr/bin/python3 scripts/stage1_summary.py --config study/stage1.live.json --note "session failed; close ran"
StandardOutput=append:/root/stage1/lake/study/logs/service.log
StandardError=inherit
User=root
